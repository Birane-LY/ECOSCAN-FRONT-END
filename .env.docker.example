# Copie ce fichier en .env.docker puis remplace les valeurs d'exemple.
# Ces valeurs sont reservees au developpement local. Ne pas les utiliser en production.
POSTGRES_DB=ecoscan
POSTGRES_USER=ecoscan
POSTGRES_PASSWORD=change-me-local-database-password
POSTGRES_HOST_PORT=5433
FRONTEND_HOST_PORT=3001
VITRINE_HOST_PORT=3000
API_HOST_PORT=8000
AI_HOST_PORT=8001

DJANGO_SECRET_KEY=change-me-local-django-key-use-a-long-random-value

# Genere deux secrets distincts avec :
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Le premier doit correspondre entre Django (AI_SERVICE_INTERNAL_TOKEN) et IA (INTERNAL_TOKEN).
# Le second doit correspondre entre Django (DJANGO_INTERNAL_TOKEN) et IA (DJANGO_INTERNAL_TOKEN).
ECOSCAN_AI_INTERNAL_TOKEN=change-me-ai-service-token
ECOSCAN_DJANGO_INTERNAL_TOKEN=change-me-django-service-token
